LineTop.BackgroundColor3 = Config.Color

-- Línea Inferior
local LineBottom = Instance.new("Frame")
LineBottom.Size = UDim2.new(0, Config.Thickness, 1, 0)
LineBottom.Position = UDim2.new(0.5, -Config.Thickness/2, 1, 0)
LineBottom.BackgroundColor3 = Config.Color

-- Línea Izquierda
local LineLeft = Instance.new("Frame")
