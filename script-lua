-- CONFIGURACIÓN
local Config = {
    Key = Enum.KeyCode.F,           -- Tecla para activar/desactivar (F)
    Color = Color3.new(1, 0, 0),    -- Color de la mira (Rojo)
    Size = 20,                      -- Tamaño de los brazos de la cruz (píxeles)
    Thickness = 2,                  -- Grosor de línea
    AutoFire = true,                -- Disparar automático
    FireDelay = 0.05,               -- Velocidad de disparo (muy rápido)
    Smoothness = 0,                 -- 0 = Inmediato (máxima velocidad), 0.5 = Suave
    MaxDistance = 500,              -- Distancia máxima
    TargetPart = "Head",            -- Prioridad de búsqueda
    Visible = true                  -- Mostrar la mira
}

-- Variables
local Players = game:GetService("Players")
