ScreenGui.Parent = CoreGui -- Usamos CoreGui para que se vea siempre

-- Función 3D a 2D
function GetScreenPos(Pos)
    local Vector = Camera:WorldToViewportPoint(Pos)
    return Vector2new(Vector.X, Vector.Y), Vector.Z > 0
end

-- Loop Principal
RunService.RenderStepped:Connect(function()
    if not IsOn then return end
    
    if not Camera then return end

    local BestPart = nil
    local BestScore = math.huge
    local Center = Vector2new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    -- Iterar jugadores
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Hum = Player.Character:FindFirstChild("Humanoid")
            if Hum and Hum.Health > 0 then
                -- Buscar partes útiles
                local PartsToCheck = {
                    Player.Character:FindFirstChild("Head"),
                    Player.Character:FindFirstChild("HumanoidRootPart"),
                    Player.Character:FindFirstChild("Torso"),
                    Player.Character:FindFirstChild("UpperTorso")
                }

                for _, Part in pairs(PartsToCheck) do
                    if Part then
                        local Pos2D, OnScreen = GetScreenPos(Part.Position)
                        if OnScreen then
                            local DistFromCenter = (Pos2D - Center).Magnitude
                            local Dist3D = (Camera.CFrame.Position - Part.Position).Magnitude

                            if DistFromCenter < Config.Size * 5 and Dist3D < Config.MaxDistance then
                                if DistFromCenter < BestScore then
                                    BestScore = DistFromCenter
                                    BestPart = Part
                                    Target = Player
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Actualizar la mira visual
    if BestPart then
        local Pos2D, _ = GetScreenPos(BestPart.Position)
        
        -- Mover la UI de la mira
        Cross.Position = UDim2.new(0, Pos2D.X - Config.Size, 0, Pos2D.Y - Config.Size)
        
        -- Auto Fire
        if Settings and Settings.AutoFire then
            if tick() - lastFireTime > Config.FireDelay then
                Mouse.Button1Down()
                lastFireTime = tick()
            end
        end
    else
        -- Volver al centro si no hay objetivo
        Cross.Position = UDim2.new(0.5, -Config.Size, 0.5, -Config.Size)
    end
end)

-- Control de Tecla
UserInputService.InputBegan:Connect(function(Input, IsGameProcessed)
    if Input.KeyCode == Config.Key then
        IsOn = not IsOn
        
        if IsOn then
            Cross.BackgroundColor3 = Config.Color
        else
            Cross.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5) -- Gris cuando está apagado
            Cross.Position = UDim2.new(0.5, -Config.Size, 0.5, -Config.Size)
        end
    end
end)

print("Aimbot Cargado Correctamente.")
